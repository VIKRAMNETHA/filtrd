# Restricted role used by the app. Row-level security applies to it.
DATABASE_URL=postgres://hireflow_app:change-me@localhost:5432/hireflow
# Owner connection, used only by `npm run db:setup`.
ADMIN_DATABASE_URL=postgres://postgres@localhost:5432/postgres
SESSION_SECRET=generate-with-openssl-rand-base64-32
APP_URL=http://localhost:3000
# Career sites are served at <slug>.<ROOT_DOMAIN>.
ROOT_DOMAIN=localhost:3000
# Protects GET /api/cron/tick when an external scheduler drives automation.
CRON_SECRET=generate-with-openssl-rand-base64-32

# Optional. Without SMTP_HOST, emails are captured in the in-app email log and not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Filtrd <no-reply@example.com>

# Optional. Without a key, resumes are scored by the built-in keyword matcher.
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-opus-5-5
